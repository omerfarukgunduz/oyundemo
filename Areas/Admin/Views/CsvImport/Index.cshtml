@model CsvImportVm
@{
    ViewData["Title"] = "CSV İçeri Aktarım";
}

<div class="row justify-content-center">
    <div class="col-xxl-7 col-xl-8">
        <div class="card card-party rounded-4 p-5 text-white mb-5">
            <div class="d-flex flex-column flex-lg-row gap-4 justify-content-between align-items-start mb-5">
                <div>
                    <p class="text-white-75 text-uppercase small fw-semibold mb-3" style="letter-spacing:.08em;">Komut çıkış</p>
                    <h1 class="h3 fw-bold text-white mb-3">Paket kartlarını yükle</h1>
                    <p class="text-white-50 mb-4">
                        Beklenen format: ilk satır <code class="text-warning">package_name,question_text</code> sonra her satır kart.
                    </p>
                </div>
                <a class="btn btn-outline-light fw-semibold rounded-pill px-4 py-3" asp-area="Admin" asp-controller="Packages" asp-action="Index">← Paketler</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Success))
            {
                <div class="alert alert-success border-0 rounded-4 fw-semibold">
                    🎊 @Model.Success
                </div>
            }

            <form asp-area="Admin" asp-controller="CsvImport" asp-action="Index" enctype="multipart/form-data" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <label class="form-label fw-semibold">CSV seç</label>
                <input class="form-control form-control-lg rounded-4 px-4 py-3 bg-dark border-0 text-white mb-4" type="file" accept=".csv,text/csv" name="file" />

                <button class="btn btn-accent w-100 rounded-pill py-3 fw-semibold mb-5" type="submit">Dosyayı yükle</button>
            </form>

            <div class="bg-dark rounded-4 p-4 border border-secondary border-opacity-25">
                <p class="text-white fw-semibold mb-3 small">Örnek:</p>
                <pre class="text-white mb-0 small">package_name,question_text
Klasik,Grup içinde en kahramanı kim?
İş Hayatı,Toplantılar şekil mi veriyor?</pre>
            </div>
        </div>
    </div>
</div>
