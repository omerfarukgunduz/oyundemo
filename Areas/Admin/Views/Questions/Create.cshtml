@model QuestionVm
@{
    ViewData["Title"] = $"Yeni kart • paket #{Model.PackageId}";
}

<div class="row justify-content-center">
    <div class="col-xl-10 col-xxl-8">
        <div class="card card-party rounded-4 p-5 text-white">
            <div class="d-flex flex-column flex-xl-row gap-6 justify-content-between mb-6">
                <h1 class="h4 fw-bold mb-4 mb-xl-0 flex-grow-1">Yeni soru 📫</h1>
                <a class="btn btn-outline-light fw-semibold rounded-pill px-6 py-3 mb-4 mb-xl-0 ms-xl-auto" asp-area="Admin" asp-controller="Questions" asp-action="Index" asp-route-packageId="@Model.PackageId">← Liste</a>
                <small class="text-white-75 d-block mb-0 mb-xl-auto">Paket bağlantısı: <strong class="text-white">@Model.PackageId</strong></small>
            </div>

            <form asp-area="Admin" asp-controller="Questions" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="PackageId" type="hidden" />

                @Html.ValidationSummary(true)
                <div class="mb-5">
                    <label asp-for="Text" class="form-label fw-bold"></label>
                    <textarea asp-for="Text" rows="11" maxlength="2000" class="form-control bg-dark border-0 rounded-4 px-5 py-4 text-white" placeholder="Gruptaki en kahraman kahveci kim 🤔"></textarea>
                    <span asp-validation-for="Text" class="small text-danger"></span>
                    <small class="text-white-50 d-inline-block mt-3">Uzun yazı daha komik 👀?</small>
                </div>

                <button type="submit" class="btn btn-accent w-100 fw-bold rounded-pill py-5">Kaydet ⚡️</button>
                <partial name="_ValidationScriptsPartial" />
            </form>
        </div>
    </div>
</div>
