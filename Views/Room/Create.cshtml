@model CreateRoomVm
@{
    ViewData["Title"] = "Oda oluştur";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7 col-xl-5">
        <div class="card card-party rounded-4 p-4 text-white mb-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="pulse-dot"></div>
                <h1 class="h3 mb-0">Yeni parti odası 🔥</h1>
            </div>

            <p class="text-white-50 mb-4">
                Küçük bir takma ad yeter — sunucuya seni hatırlatacak gizli bir çerez bırakıyoruz, böylece odaya çık çık gelebilirsin.
            </p>

            <form asp-action="Create" asp-controller="Room" method="post" class="needs-validation">
                @Html.ValidationSummary(false, "", new { @class = "text-danger small mb-3" })
                @Html.AntiForgeryToken()
                <label class="form-label fw-semibold" asp-for="Nickname"></label>
                <input class="form-control form-control-lg bg-dark text-white border-0 rounded-4 mb-3" asp-for="Nickname" maxlength="32" placeholder="Takma adını yaz" autocomplete="nickname" autofocus />

                <label class="form-label fw-semibold" asp-for="RoundTimerSeconds"></label>
                <select class="form-select form-select-lg bg-dark border-0 text-white rounded-4 mb-1" asp-for="RoundTimerSeconds">
                    <option value="0">Süre yok (tur manuel bitebilir)</option>
                    <option value="30">30 saniye</option>
                    <option value="60">60 saniye</option>
                    <option value="90">90 saniye</option>
                    <option value="120">120 saniye</option>
                </select>
                <p class="text-white-50 small mb-4">Süre dolunca süre atan turlarda kartlar otomatik açılır.</p>

                <button class="btn btn-accent btn-lg w-100 rounded-pill fw-bold" type="submit">Masayı Hazırla</button>
            </form>

            <p class="small text-white-50 mt-3 mb-0 text-center">
                Zaten arkadaşından kod aldıysan
                <a class="fw-semibold text-white" asp-action="Join" asp-controller="Room">Oyuna katıl</a> sayfasına geç.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
