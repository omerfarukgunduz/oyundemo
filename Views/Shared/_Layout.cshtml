@using IfsaKlasik.Web.Models
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - İFŞA Klasik</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Sora:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/party.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="party-body @(ViewBag.BodyClass ?? string.Empty)">
    <nav class="navbar navbar-expand-lg navbar-dark bg-transparent party-nav border-0 sticky-top mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold gradient-text fs-4" asp-controller="Home" asp-action="Index">İFŞA Klasik</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto gap-lg-3 align-items-lg-center">
                    <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Home" asp-action="Index" asp-fragment="nasil">Nasıl oynanır</a></li>
                    <li class="nav-item"><a class="btn btn-accent btn-sm rounded-pill px-3 fw-semibold" asp-controller="Room" asp-action="Create">Oda Aç</a></li>
                    <li class="nav-item"><a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Room" asp-action="Join">Katıl</a></li>
                    @if (User.IsInRole(IfsaRoles.Admin))
                    {
                        <li class="nav-item">
                            <a class="btn btn-light btn-sm rounded-pill fw-semibold" asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a>
                        </li>
                        <li class="nav-item">
                            <form class="m-0" asp-area="Admin" asp-controller="Login" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link nav-link fw-semibold">Çıkış</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="@(ViewBag.FullBleedMain == true ? string.Empty : "container pb-5")">
        @RenderBody()
    </main>

    <footer class="border-top border-light border-opacity-25 py-5 mt-auto text-center party-footer-text">
        <small>İFŞA Klasik — sıcak kahkaha garantisi&nbsp;*</small><br/>
        <small class="opacity-75">*&nbsp;hukuken garanti yoktur, sorumluluğu yüz yüze teslim&nbsp;:)</small>
    </footer>

    <div id="ifsSnack"
         role="status"
         aria-live="polite"
         aria-atomic="true"
         class="ifs-push-toast px-4 py-3 rounded-4 fw-semibold text-bg-dark shadow-lg border border-light border-opacity-25"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
